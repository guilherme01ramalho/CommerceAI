      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\nconst acao = String(body.acao ?? '').trim().toLowerCase();\nconst dados = body.dados ?? {};\n\nconst erros = [];\n\nconst acoesPermitidas = [\n  'cadastrar_cliente',\n  'consultar_cliente',\n  'alterar_cliente'\n];\n\n// Validação da ação\nif (!acao) {\n  erros.push('O campo \"acao\" é obrigatório.');\n}\n\nif (acao && !acoesPermitidas.includes(acao)) {\n  erros.push(`Ação \"${acao}\" não é suportada.`);\n}\n\n// Validação dos dados\nif (!body.dados || typeof body.dados !== 'object') {\n  erros.push('O campo \"dados\" é obrigatório e deve ser um objeto.');\n}\n\n// Validação para cadastro\nif (acao === 'cadastrar_cliente') {\n  const nomeCadastro = dados.Nome ?? dados.nome ?? null;\n  if (!nomeCadastro || String(nomeCadastro).trim() === '') {\n    erros.push('O campo \"nome\" é obrigatório para cadastrar um cliente.');\n  }\n}\n\n// Validação para consulta e alteração\nif (acao === 'consultar_cliente' || acao === 'alterar_cliente') {\n  if (!dados.IdCliente) {\n    erros.push('O campo \"IdCliente\" é obrigatório.');\n  }\n\nconst emailCadastro = dados['E-mail'] ?? dados.Email ?? dados.email ?? null;\n  if (!emailCadastro || String(emailCadastro).trim() === '') {\n    erros.push('O campo \"email\" é obrigatório para cadastrar um cliente.');\n  }\n\n}\n\n// Validação do e-mail\nconst emailDados = dados['E-mail'] ?? dados.Email ?? dados.email ?? null;\nif (emailDados) {\n  const email = String(emailDados).trim();\n\n  const emailValido = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\n  if (!emailValido) {\n    erros.push('O formato do e-mail é inválido.');\n  }\n}\n\n// Retorno - CORRIGIDO para aceitar Maiúsculas e minúsculas\nreturn [\n  {\n    json: {\n      sucesso: erros.length === 0,\n      acao,\n      dados: {\n        IdCliente: dados.IdCliente ?? dados.id ?? null,\n        Nome: dados.Nome ?? dados.nome ?? null,\n        Email: dados['E-mail'] ?? dados.Email ?? dados.email ?? null,\n        Telefone: dados.Telefone ?? dados.telefone ?? null,\n        Status: dados.Status ?? dados.status ?? null\n      },\n      erros\n    }\n  }\n];"
      },
