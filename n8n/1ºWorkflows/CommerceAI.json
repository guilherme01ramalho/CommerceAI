      "parameters": {
        "jsCode": "// Decidir se cadastra ou retorna erro\nconst resultado = $input.all();\n\n// Verifica se o SELECT retornou dados (email existe)\nif (resultado.length > 0 && resultado[0].json && resultado[0].json.IdCliente) {\n  // Email já existe\n  const clienteExistente = resultado[0].json;\n  \n  return [{\n    json: {\n      emailExiste: true,\n      mensagem: \"Cliente já cadastrado com este email.\",\n      clienteExistente: {\n        id: clienteExistente.IdCliente,\n        nome: clienteExistente.Nome,\n        email: clienteExistente[\"E-mail\"] || clienteExistente.Email,\n        telefone: clienteExistente.Telefone,\n        dataCadastro: clienteExistente.DataCadastro,\n        status: clienteExistente.Status\n      }\n    }\n  }];\n} else {\n  // Email não existe - prepara para cadastro\n  // Tenta diferentes fontes para os dados originais\n  let dadosOriginais = null;\n  \n  // Tenta pegar do nó anterior\n  if ($('Direcionar Ação').item && $('Direcionar Ação').item.json) {\n    dadosOriginais = $('Direcionar Ação').item.json.dados;\n  }\n  \n  // Se não encontrou, tenta do $json atual\n  if (!dadosOriginais && $json && $json.dados) {\n    dadosOriginais = $json.dados;\n  }\n  \n  // Se ainda não encontrou, tenta do input\n  if (!dadosOriginais && resultado[0] && resultado[0].json) {\n    dadosOriginais = resultado[0].json.dados;\n  }\n  \n  return [{\n    json: {\n      emailExiste: false,\n      dadosCadastro: dadosOriginais\n    }\n  }];\n}"
