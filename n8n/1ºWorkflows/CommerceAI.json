        "jsCode": "// Formatar Resposta da Alteração de Cliente\nconst resultado = $input.all();\n\n// Verifica se o MySQL retornou algum registro\nif (resultado.length === 0 || !resultado[0].json || Object.keys(resultado[0].json).length === 0) {\n  // Cenário: Cliente não encontrado após atualização (erro inesperado)\n  return [{\n    json: {\n      sucesso: false,\n      mensagem: \"Erro ao atualizar cliente. Tente novamente.\",\n      cliente: null\n    }\n  }];\n}\n\n// Cliente atualizado - pega o primeiro registro\nconst clienteData = resultado[0].json;\n\n// Formata a resposta de sucesso\nreturn [{\n  json: {\n    sucesso: true,\n    mensagem: \"Cliente atualizado com sucesso.\",\n    cliente: {\n      id: clienteData.IdCliente,\n      nome: clienteData.Nome,\n      email: clienteData[\"E-mail\"] || clienteData.Email || \"\",\n      telefone: clienteData.Telefone || \"\",\n      dataCadastro: clienteData.DataCadastro || \"\",\n      status: clienteData.Status || \"\"\n    }\n  }\n}];"
